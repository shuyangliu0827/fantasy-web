# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ball Don't Lie API
BDL_API_KEY=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cron auth
CRON_SECRET=

# Supabase server-side (optional but recommended; falls back to anon key)
SUPABASE_SERVICE_ROLE_KEY=

# Basketball league dev/seed utility (POST /api/dev/grant-basketball-access)
DEV_ADMIN_SECRET=

# Public base URL (used for absolute links)
NEXT_PUBLIC_BASE_URL=

# AI lineup-post generator (app/api/ai/generate-lineup-post)
ANTHROPIC_API_KEY=
# Optional override (default: claude-haiku-4-5-20251001)
AI_LINEUP_POST_MODEL=

# PostHog analytics (Product Analytics + Web Analytics + Session Replay).
# Both vars are PUBLIC — they are inlined into the client bundle.
# Leave the token blank to disable analytics (init becomes a no-op).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Region host: https://us.i.posthog.com (default) or https://eu.i.posthog.com.
# In production, point this at a same-domain reverse proxy (e.g. /ingest)
# for more reliable delivery in China — see ANALYTICS_SETUP.md.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
